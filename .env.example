# Acumius Configuration
# Copy this file to .env and customize for your environment

# Server
ACUMIUS_SERVER_PORT=8080
ACUMIUS_LOG_LEVEL=info
ACUMIUS_ENV=development

# Database
ACUMIUS_DATABASE_URL=postgres://acumius:acumius@localhost:5432/acumius?sslmode=disable

# Valkey (Redis-compatible)
ACUMIUS_VALKEY_URL=localhost:6379

# Security
ACUMIUS_JWT_SECRET=change-me-in-production
ACUMIUS_API_KEY_SALT=change-me-in-production

# Embedding (placeholder for v0.1, real model in v0.2)
ACUMIUS_EMBEDDING_PROVIDER=placeholder
ACUMIUS_EMBEDDING_DIMENSION=1536

# Policy
ACUMIUS_POLICY_CACHE_TTL=5m
ACUMIUS_DEFAULT_POLICY_PATH=./policies/default.yaml

# Audit
ACUMIUS_AUDIT_RETENTION_DAYS=90
ACUMIUS_AUDIT_BATCH_SIZE=100

# GDPR
ACUMIUS_GDPR_AUTO_EXPIRE=true
ACUMIUS_GDPR_EXPIRY_CHECK_INTERVAL=1h
